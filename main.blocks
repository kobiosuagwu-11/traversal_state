"pxt_automatic_disabled"><field name="ms">500</field></shadow></value></block></statement></block><block type="spriteshittile" id="t`qPBzSBVj`P]{gm3:sM" x="-871" y="-132"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="T2^VS,ap1#b6f~/e|e%Q" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="H3~{!WxXIXovd8S|d*Tx"><field name="MEMBER">Player</field></shadow></value><value name="tile"><shadow type="tileset_tile_picker" id="?3S_Fs363u+V*-@w9O--"><field name="tile">assets.tile`myTile16`</field></shadow></value><value name="HANDLER_DRAG_PARAM_location"><block type="argument_reporter_custom" id="#775BK:R-8eP_5LV2lPF" deletable="false"><mutation typename="tiles.Location"></mutation><field name="VALUE">location</field></block></value><statement name="HANDLER"><block type="gameSplash" id="ItwT$zfTz/QPtzrFP`.]"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="(/A:;Tz-(#/@!f!GdG~|"><field name="TEXT">Welcome to the game!</field></shadow></value><value name="subtitle"><shadow type="text" id="M6IY.50zV?5#d+[_RL{9"><field name="TEXT">Press A to start.</field></shadow></value><next><block type="music_playable_play" id="Mt(F-1`2?7Y=`6~zN(do"><field name="playbackMode">music.PlaybackMode.LoopingInBackground</field><value name="toPlay"><shadow type="music_string_playable" id="-A_3cSrB68=QDIf;Kkdg"><value name="melody"><shadow type="melody_editor" id=")brG${d[~`v1wNM[Gxg0"><field name="melody">"A G G F G F A F "</field></shadow></value><value name="tempo"><shadow type="math_number_minmax" id="zzQ?o;Ef,cu}T-IiZF{;"><mutation min="40" max="500" label="Tempo" precision="0"></mutation><field name="SLIDER">85</field></shadow></value></shadow></value><next><block type="game_show_long_text" id="y?cm0q:7kU`*tHf}t{|2"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="--YX!y?,5^7y!;-_=*Ei"><field name="TEXT">This is the story of a little slime ball named Bob. Bob lives in California, but the taxes are WAYYYY too high. Now, Bob regrets moving to California, and he wants to start fresh across the country in New York! There's only one problem though, Bob doesn't have a car, so can't drive because slime balls can't get driver's liscences, and he can't go by himself because he's too scared to go alone (what a crybaby). Anyways, Bob needs your help to get across the U.S. Can you help Bob complete this journey? </field></shadow></value><next><block type="game_show_long_text" id="|08n;Z%X$1}3CWn!v6FY"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="8BO-Lk1D5*]Z!=:%@},s"><field name="TEXT">And before you depart, there's something you should know. Bob has a really tight schedule. It would surely suck if Bob missed his flight, or didn't reach his Uber on time, right? So just try to be as quick as possible getting Bob to a destination. And always remember,     the clock is ALWAYS ticking!</field></shadow></value><next><block type="music_stop_all_sounds" id=";;HmcayhAg(q#t%s?1Lh"><next><block type="music_playable_play" id="]TJrk#Y6Z3*U-S:NHV5T"><field name="playbackMode">music.PlaybackMode.LoopingInBackground</field><value name="toPlay"><shadow type="music_string_playable" id="aY}kfBz=yv1rC`F?E7wX"><value name="melody"><shadow type="melody_editor" id="|/IiImBDgO%4EJ`+6%Z)"><field name="melody">"G B A G C5 B A G "</field></shadow></value><value name="tempo"><shadow type="math_number_minmax" id="oYnO?D5[8D/=4XBiKI.^"><mutation min="40" max="500" label="Tempo" precision="0"></mutation><field name="SLIDER">165</field></shadow></value></shadow></value><next><block type="music_playable_play" id="R:jd%_VFsEPn2iRzQ[%j"><field name="playbackMode">music.PlaybackMode.LoopingInBackground</field><value name="toPlay"><shadow type="music_string_playable" id="1D;/5s@cy0{Q(2E2qQ-q"><valu